# Copy to /srv/timecard/.env.prod (chmod 640). The web UI itself is protected by Cloudflare
# Access, not by anything in here.

# Bearer token required by POST /api/punch (Shortcuts / curl punching that bypasses Access).
# Leave empty to disable that endpoint's protection — only sensible if Access covers it too.
#   openssl rand -hex 32
TIMECARD_TOKEN=
